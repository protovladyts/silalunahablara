// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?  // Nombre del usuario (opcional)
  hasFreeTarot Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  tarotSessions TarotSession[]
  sessions      Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  question  String
  cards     String[]
  reading   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model OtpEntry {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("otp_entries")
}

model TarotSession {
  id          String   @id @default(cuid())
  userId      String
  status      TarotStatus @default(INTAKE)
  loopsUsed   Int      @default(0)
  question    String?
  shuffleSeed String?
  deckOrder   Int[]
  cutIndex    Int?
  drawnCards  Json?    // Array of {id: number, name: string, upright: boolean}
  reading     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tarot_sessions")
}

enum TarotStatus {
  INTAKE
  SHUFFLED
  DRAWN
  READING
  COMPLETE
}
